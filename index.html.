'Космічний мандрівник','Неоновий дракон','Темний янгол','Кристальний вовк',
'Електричний привид','Королівський сокіл','Палаючий демон','Срібний самурай',
'Галактичний воїн','Рубіновий страж','Лазурний тигр','Примарний король',
'Зоряний мандрівник','Місячний асасин','Бурштиновий голем','Піксельний герой',
'Кіберпанк','Вартовий безодні','Дракон часу','Володар бурі',
'Залізний титан','Сонячний лицар','Космічний рейнджер','Легенда ночі',
'Квантовий воїн','Король галактики','Вічний фенікс','Сапфіровий дух',
'Дух пустелі','Крижаний дракон','Неоновий самурай','Володар світла',
'Тінь галактики','Золотий голем','Вогняний король','Темний титан',
'Космічний лев','Рубіновий дракон','Срібний фенікс','Привид майбутнього',
'Володар часу','Бурштиновий лицар','Галактичний страж','Кристальний демон',
'Зоряний король','Абсолютний герой','Дух нескінченності','Останній дракон',
'Володар космосу','Титан світла','Темна матерія','Бог грому',
'Перший фенікс','Король виміру','Вічна легенда','SMOBX LEGEND'
];

const icons=['🔥','❄️','🌑','✨','🌌','🐉','😇','🐺','⚡','🦅','👹','⚔️','🌠','♦️','🐯','👻','🌟','🌙','🟠','🎮'];

const prices=[45,72,95,118,137,164,190,225,260,310,355,420,480,550,630,720,840,960,1100,1280,1450,1680,1950,2250,2600,3000,3500,4100,4800,5600,6500,7600,8900,10400,12200,14300,16800,19700,23100,27000,31600,37000,43300,50700,59400,69600,81500,95500,112000,131000,153000,179000,210000,246000,288000,337000,395000,462000,540000,630000];

const rarityData=[
{name:'Звичайний',cls:'common'},
{name:'Рідкісний',cls:'rare'},
{name:'Епічний',cls:'epic'},
{name:'Легендарний',cls:'legendary'}
];

const catalog=names.map((name,i)=>{
let r=i<20?0:i<38?1:i<52?2:3;
return {id:'skin_'+i,name,price:prices[i],rarity:rarityData[r].name,cls:rarityData[r].cls,icon:icons[i%icons.length]};
});

/* Діапазони скінів підібрані ближче до ціни кожного кейса */
const cases=[
{id:'bronze',name:'BRONZE CASE',emoji:'📦',price:100,min:0,max:19},
{id:'gold',name:'GOLD CASE',emoji:'🎁',price:500,min:7,max:27},
{id:'royal',name:'ROYAL CASE',emoji:'👑',price:1500,min:15,max:35},
{id:'diamond',name:'DIAMOND CASE',emoji:'💎',price:3000,min:20,max:43},
{id:'mythic',name:'MYTHIC CASE',emoji:'🔮',price:7500,min:26,max:51},
{id:'infinity',name:'INFINITY CASE',emoji:'♾️',price:15000,min:32,max:59}
];

const promoCodes={SMOBX100:100,WELCOME500:500,GOLD2026:1500,DIAMOND3000:3000,LEGEND10000:10000};

let data;
try{data=JSON.parse(localStorage.getItem('smobx_save'))||{}}catch(e){data={}}

data.coins=Number(data.coins??0);
data.xp=Number(data.xp??0);
data.level=Number(data.level??1);
data.power=Number(data.power??1);
data.upgradeLevel=Number(data.upgradeLevel??1);
data.upgradePrice=Number(data.upgradePrice??50);
data.totalClicks=Number(data.totalClicks??0);
data.totalEarned=Number(data.totalEarned??0);
data.inventory=Array.isArray(data.inventory)?data.inventory:[];
data.promoUsed=Array.isArray(data.promoUsed)?data.promoUsed:[];
data.casesOpened=Number(data.casesOpened??0);
data.upgradesWon=Number(data.upgradesWon??0);

data.inventory=data.inventory.map((x,i)=>{
if(typeof x==='string')return {...(catalog.find(s=>s.id===x)||catalog[0]),uid:'old_'+i};
if(Array.isArray(x))return {id:'old_'+i,uid:'old_'+i,name:x[0]||'Предмет',rarity:x[1]||'Звичайний',cls:x[2]||'common',icon:x[3]||'🎁',price:Number(x[4]||100)};
return {...x,uid:x.uid||'old_'+i,price:Number(x.price||100)};
});

let currentCase=null,caseBusy=false,upgradeBusy=false;

function money(n){return Math.round(n).toLocaleString('uk-UA')}
function save(){localStorage.setItem('smobx_save',JSON.stringify(data));render()}

function render(){
document.getElementById('coins').textContent=money(data.coins);
document.getElementById('xp').textContent=data.xp;
document.getElementById('level').textContent=data.level;
document.getElementById('power').textContent=data.power;
document.getElementById('upgradeLevel').textContent=data.upgradeLevel;
document.getElementById('upgradePrice').textContent=money(data.upgradePrice);
document.getElementById('totalClicks').textContent=money(data.totalClicks);
document.getElementById('totalEarned').textContent=money(data.totalEarned);
document.getElementById('nextxp').textContent=data.level*100;
document.getElementById('xpbar').style.width=(data.xp/(data.level*100)*100)+'%';
document.getElementById('profileCoins').textContent=money(data.coins);
document.getElementById('profileLevel').textContent=data.level;
document.getElementById('casesOpened').textContent=data.casesOpened;
document.getElementById('upgradesWon').textContent=data.upgradesWon;
document.getElementById('profileItems').textContent=data.inventory.length;
document.getElementById('inventoryCount').textContent=data.inventory.length;
document.getElementById('inventoryValue').textContent=money(data.inventory.reduce((s,x)=>s+x.price,0));
renderInventory();
}

function showPage(id,btn){
document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('active'));
document.getElementById(id).classList.add('active');
if(btn)btn.classList.add('active');
if(id==='upgrader')renderUpgrader();
}

function clickCoin(){
data.coins+=data.power;
data.totalEarned+=data.power;
data.totalClicks++;
data.xp+=2;
checkLevel();
save();
}

function checkLevel(){
while(data.xp>=data.level*100){
data.xp-=data.level*100;
data.level++;
document.getElementById('message').textContent='🎉 Новий рівень! '+data.level;
}
}

function upgrade(){
if(data.coins<data.upgradePrice)return alert('Недостатньо монет!');
data.coins-=data.upgradePrice;
data.upgradeLevel++;
data.power++;
data.upgradePrice=Math.floor(data.upgradePrice*1.7);
save();
}

function renderCases(){
document.getElementById('caseGrid').innerHTML=cases.map(c=>`
<div class="card">
<div class="case">${c.emoji}</div>
<h3>${c.name}</h3>
<p>Ціна: ${money(c.price)} 🪙</p>
<button onclick="startCase('${c.id}')">ВІДКРИТИ КЕЙС</button>
</div>`).join('');
}

/*
Фіксовані шанси:
Звичайний — 97%
Рідкісний — 2,5%
Епічний — 0,45%
Легендарний — 0,05%

Якщо певної рідкості немає в кейсі,
її шанс переходить до найближчої доступної рідкості.
*/

function weightedPick(pool,casePrice){
  const weights=[
    {rarity:'common',chance:97},
    {rarity:'rare',chance:2.5},
    {rarity:'epic',chance:0.45},
    {rarity:'legendary',chance:0.05}
  ];

  const available=['common','rare','epic','legendary']
    .filter(r=>pool.some(x=>x.cls===r));

  let roll=Math.random()*100;
  let desired='common';
  let cumulative=0;

  for(const w of weights){
    cumulative+=w.chance;
    if(roll<cumulative){
      desired=w.rarity;
      break;
    }
  }

  if(!available.includes(desired)){
    const order=['common','rare','epic','legendary'];
    const desiredIndex=order.indexOf(desired);
    available.sort((a,b)=>
      Math.abs(order.indexOf(a)-desiredIndex)-
      Math.abs(order.indexOf(b)-desiredIndex)
    );
    desired=available[0];
  }

  const items=pool.filter(x=>x.cls===desired);

  const weighted=items.map(item=>{
    const ratio=item.price/casePrice;
    let weight=1/Math.pow(Math.max(ratio,0.01),1.15);

    if(ratio>3)weight*=0.35;
    if(ratio>10)weight*=0.1;

    return {item,weight};
  });

  const total=weighted.reduce((s,x)=>s+x.weight,0);
  let pick=Math.random()*total;

  for(const x of weighted){
    pick-=x.weight;
    if(pick<=0)return x.item;
  }

  return weighted[weighted.length-1].item;
}

function startCase(id){
if(caseBusy)return;

let c=cases.find(x=>x.id===id);
if(data.coins<c.price){
alert('Недостатньо монет!');
return;
}

data.coins-=c.price;
data.casesOpened++;
currentCase=c;
caseBusy=true;

document.getElementById('caseOpening').style.display='block';
document.getElementById('caseTitle').textContent=c.name;
document.getElementById('caseResult').textContent='Рулетка крутиться...';
document.getElementById('caseOpenAgain').disabled=true;

let track=document.getElementById('caseTrack');
track.innerHTML='';

let pool=catalog.slice(c.min,c.max+1);
let winner=weightedPick(pool,c.price);
let list=[];

for(let i=0;i<32;i++){
list.push(weightedPick(pool,c.price));
}
list[27]=winner;

track.innerHTML=list.map(x=>`
<div class="rouletteItem">
<div class="emoji">${x.icon}</div>
<b class="${x.cls}">${x.name}</b>
<span>${money(x.price)} 🪙</span>
</div>`).join('');

track.style.transition='none';
track.style.transform='translateX(0)';

save();

requestAnimationFrame(()=>requestAnimationFrame(()=>{
let item=track.children[27];
let windowEl=document.querySelector('#caseOpening .rouletteWindow');
let target=item.offsetLeft+item.offsetWidth/2-windowEl.clientWidth/2;

track.style.transition='transform 5s cubic-bezier(.10,.75,.08,1)';
track.style.transform=`translateX(-${target}px)`;

setTimeout(()=>{
data.inventory.push({
...winner,
uid:'item_'+Date.now()+'_'+Math.random()
});

document.getElementById('caseResult').innerHTML=
'🎉 ВИПАЛО: <b class="'+winner.cls+'">'+winner.icon+' '+winner.name+
'</b><br>Вартість: '+money(winner.price)+' 🪙';

document.getElementById('caseOpenAgain').disabled=false;
caseBusy=false;
save();
},5150);
}));
}

function spinCase(){
if(currentCase&&!caseBusy)startCase(currentCase.id);
}

function closeCase(){
if(caseBusy)return;
document.getElementById('caseOpening').style.display='none';
}

function renderInventory(){
document.getElementById('inventoryGrid').innerHTML=data.inventory.length?data.inventory.map(x=>`
<div class="item">
<div class="emoji">${x.icon}</div>
<strong class="${x.cls}">${x.name}</strong>
<div class="small">${x.rarity}</div>
<p>${money(x.price)} 🪙</p>
<button onclick="sellItem('${x.uid}')">ПРОДАТИ</button>
</div>`).join(''):'<p class="muted">Інвентар порожній. Відкрий кейс!</p>';
}

function sellItem(uid){
let i=data.inventory.findIndex(x=>x.uid===uid);
if(i<0)return;
let item=data.inventory.splice(i,1)[0];
data.coins+=item.price;
save();
}

function activatePromo(){
let code=document.getElementById('promoInput').value.trim().toUpperCase();
if(!promoCodes[code]){
document.getElementById('promoResult').textContent='❌ Невідомий промокод.';
return;
}
if(data.promoUsed.includes(code)){
document.getElementById('promoResult').textContent='❌ Уже використаний.';
return;
}
data.coins+=promoCodes[code];
data.promoUsed.push(code);
document.getElementById('promoResult').textContent='🎉 +'+money(promoCodes[code])+' монет!';
document.getElementById('promoInput').value='';
save();
}

function renderUpgrader(){
let from=document.getElementById('upgradeFrom');
let old=from.value;
from.innerHTML=data.inventory.map(x=>`
<option value="${x.uid}">${x.icon} ${x.name} — ${money(x.price)}</option>`).join('');
if(!data.inventory.length)from.innerHTML='<option value="">Інвентар порожній</option>';
if([...from.options].some(o=>o.value===old))from.value=old;
updateUpgradeTargets();
}

function updateUpgradeTargets(){
let from=data.inventory.find(x=>x.uid===document.getElementById('upgradeFrom').value);
let to=document.getElementById('upgradeTo');
let old=to.value;
let targets=catalog.filter(x=>!from||x.price>from.price);

to.innerHTML=targets.map(x=>`
<option value="${x.id}">${x.icon} ${x.name} — ${money(x.price)}</option>`).join('');

if(!targets.length)to.innerHTML='<option value="">Немає дорожчих скінів</option>';
if([...to.options].some(o=>o.value===old))to.value=old;
updateUpgradeInfo();
}

function calculateChance(a,b){
let r=b/a;
let table=[[1.5,45],[2,30],[3,18],[5,10],[10,5],[20,2.5],[50,1]];
if(r<=1.5)return 45;
for(let i=1;i<table.length;i++){
if(r<=table[i][0]){
let prev=table[i-1],cur=table[i];
let t=(Math.log(r)-Math.log(prev[0]))/(Math.log(cur[0])-Math.log(prev[0]));
return prev[1]+(cur[1]-prev[1])*t;
}
}
return .5;
}

function updateUpgradeInfo(){
let from=data.inventory.find(x=>x.uid===document.getElementById('upgradeFrom').value);
let to=catalog.find(x=>x.id===document.getElementById('upgradeTo').value);

if(!from||!to||to.price<=from.price){
document.getElementById('upgradeChance').textContent='—';
document.getElementById('upgradeHint').textContent='Обери два предмети.';
document.getElementById('upgradeDifference').textContent='';
return;
}

let chance=calculateChance(from.price,to.price);
document.getElementById('upgradeChance').textContent='Шанс успіху: '+chance.toFixed(1)+'%';
document.getElementById('upgradeHint').textContent='Твій предмет: '+money(from.price)+' 🪙 · Ціль: '+money(to.price)+' 🪙';
document.getElementById('upgradeDifference').textContent='Різниця: '+money(to.price-from.price)+' 🪙';
}

function performUpgrade(){
if(upgradeBusy)return;

let from=data.inventory.find(x=>x.uid===document.getElementById('upgradeFrom').value);
let to=catalog.find(x=>x.id===document.getElementById('upgradeTo').value);

if(!from||!to||to.price<=from.price)return;

let chance=calculateChance(from.price,to.price);
let won=Math.random()*100<chance;

upgradeBusy=true;
document.getElementById('upgradeButton').disabled=true;
document.getElementById('upgradeResult').textContent='Стрілка крутиться...';

let wheel=document.getElementById('upgradeWheel');
let turns=1440+Math.random()*1440;
let angle=Math.random()*1440;

wheel.style.transition='transform 4s cubic-bezier(.12,.7,.12,1)';
wheel.style.transform=`rotate(${turns+angle}deg)`;

setTimeout(()=>{
let index=data.inventory.findIndex(x=>x.uid===from.uid);

if(won&&index>=0){
data.inventory.splice(index,1,{...to,uid:'upgrade_'+Date.now()});
data.upgradesWon++;
document.getElementById('upgradeResult').innerHTML=
'🎉 УСПІХ! Ти отримав <b class="'+to.cls+'">'+to.name+'</b>!';
}else if(index>=0){
data.inventory[index].price=Math.max(1,Math.floor(data.inventory[index].price/2));
document.getElementById('upgradeResult').textContent=
'❌ Не пощастило! Ціна твого скіна зменшилася на 50%.';
}

upgradeBusy=false;
document.getElementById('upgradeButton').disabled=false;
save();
renderUpgrader();
},4100);
}

document.getElementById('upgradeFrom').addEventListener('change',updateUpgradeTargets);

renderCases();
render();
</script>
</body>
</html>

.wheel{width:100%;height:100%;border-radius:50%;border:5px solid #ffbd35;background:conic-gradient(#a85d11 0 45deg,#242424 45deg 90deg,#d18a22 90deg 135deg,#242424 135deg 180deg,#a85d11 180deg 225deg,#242424 225deg 270deg,#d18a22 270deg 315deg,#242424 315deg 360deg);transition:transform 4s cubic-bezier(.12,.7,.12,1);box-shadow:0 0 22px #a66c18}
.wheelArrow{position:absolute;top:-13px;left:50%;transform:translateX(-50%);font-size:34px;color:#ffbd35;z-index:2}
